# GATEWAY settings (the public server). Copy to gateway.env there (never committed). See README.md.

# DuckDNS (free): the two names and the account token
VPN_HOST=lexcorp-vpn.duckdns.org
APP_HOST=lexcorp-app.duckdns.org
DUCKDNS_TOKEN=

# Google sign-in client. Authorised redirect URI: https://<VPN_HOST>:<LOGIN_PORT>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can connect (comma-separated)
ALLOWED_EMAILS=

# Ports open on the server (cloud firewall + OS firewall): VPN (UDP), sign-in page (TCP); plus 51820/UDP for the site link
VPN_PORT=1194
LOGIN_PORT=9443

# Site link (WireGuard). Generate with: python scripts/vpn_site_link_keys.py
WG_GATEWAY_PRIVATE_KEY=
WG_SITE_PUBLIC_KEY=
WG_PRESHARED_KEY=
