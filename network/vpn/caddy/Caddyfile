# LexCorp2 VPN: two HTTPS sites, both with Let's Encrypt certificates obtained through DuckDNS.
{
	admin off
}

(duckdns_tls) {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}
}

# 1. The VPN sign-in page (public: the person's browser opens it before the VPN is connected).
#    It only forwards to the sign-in service, which sends people to Google.
https://{$VPN_HOST}:9443 {
	import duckdns_tls
	reverse_proxy auth:9000
}

# 2. LexCorp2 itself, only on this container's private address, which is reachable only through
#    the VPN (the app's DuckDNS name points to it). Forwards to the app on the host machine.
https://{$APP_HOST} {
	bind {$APP_IP}
	import duckdns_tls
	reverse_proxy host.docker.internal:5173
}
