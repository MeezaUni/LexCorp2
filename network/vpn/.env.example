# Copy to network/vpn/.env (git-ignored) and fill in. See README.md for where each value comes from.

# DuckDNS (free): two names under one account, and the account token
VPN_HOST=lexcorp2-vpn.duckdns.org
APP_HOST=lexcorp2-app.duckdns.org
DUCKDNS_TOKEN=

# Google sign-in client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorised redirect URI: https://<VPN_HOST>:<LOGIN_PORT>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can connect (comma-separated)
ALLOWED_EMAILS=

# Ports forwarded on the router to this machine: VPN (UDP) and the sign-in page (TCP)
VPN_PORT=1194
LOGIN_PORT=9443
