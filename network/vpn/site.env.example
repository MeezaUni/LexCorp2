# SITE settings (the machine running LexCorp2). Copy to site.env (never committed). See README.md.

# The app's DuckDNS name and the DuckDNS token (for the app's HTTPS certificate)
APP_HOST=lexcorp-app.duckdns.org
DUCKDNS_TOKEN=

# The gateway's site-link address
GATEWAY_ENDPOINT=lexcorp-vpn.duckdns.org:51820

# Site link (WireGuard). Generate with: python scripts/vpn_site_link_keys.py
WG_SITE_PRIVATE_KEY=
WG_GATEWAY_PUBLIC_KEY=
WG_PRESHARED_KEY=
