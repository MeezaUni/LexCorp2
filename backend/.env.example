# backend/.env - generated by `python scripts/init_secrets.py`; never commit the real file.
# In production supply these from a secret manager instead of a file.
ENVIRONMENT=development            # development | test | production (default when unset: production)
DEBUG=false
DATABASE_URL=postgresql+asyncpg://lexcorp:<password>@127.0.0.1:5432/lexcorp_sih
DATABASE_URL_SYNC=postgresql://lexcorp:<password>@127.0.0.1:5432/lexcorp_sih
JWT_SECRET=<random, >= 32 chars; session tokens only>
VC_SIGNING_SECRET=<random, >= 32 chars; different from JWT_SECRET>
DATA_ENCRYPTION_KEYS=<Fernet key[,older keys for rotation]>
CHAIN_OPERATOR_PRIVATE_KEY=<backend registrar key; holds REGISTRAR_ROLE only>
PUBLIC_BASE_URL=http://localhost:5173   # production: https:// origin used in QR codes
# Optional:
# RPC_URL=http://127.0.0.1:8545
# CORS_ORIGINS=["https://lexcorp.example.org"]
# WEBAUTHN_ORIGINS=["https://lexcorp.example.org"]
# RP_ID=lexcorp.example.org
# TRUSTED_PROXIES=["127.0.0.1/32"]
# AI_ALERT_MODE=calibrated          # calibrated | raw | off
