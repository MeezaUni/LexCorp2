{
    "model_name": "LexCorp_IsolationForest_Unsupervised",
    "random_seed": 42,
    "n_estimators": 300,
    "contamination": "auto",
    "features": {
        "numerical": [
            "access_hour",
            "is_weekend",
            "time_elapsed_from_last_tx",
            "role_escalation_index",
            "rolling_event_frequency_1h",
            "rolling_failure_rate_24h",
            "asset_sensitivity_tier",
            "is_write_operation",
            "actor_to_asset_relationship_depth"
        ],
        "categorical": [
            "user_role",
            "event_type"
        ]
    },
    "risk_mapping": {
        "type": "linear_centered",
        "formula": "clip(50.0 - (decision_score * 250.0), 0.0, 100.0)",
        "intercept": 50.0,
        "multiplier": 250.0,
        "risk_tiers": {
            "LOW": [
                0.0,
                24.99
            ],
            "MEDIUM": [
                25.0,
                49.99
            ],
            "HIGH": [
                50.0,
                74.99
            ],
            "CRITICAL": [
                75.0,
                100.0
            ]
        }
    },
    "baseline_stats": {
        "mean_decision_score": 0.05314439518412153,
        "median_decision_score": 0.05568117528368988,
        "p1_decision_score": -0.08410506541353996,
        "p5_decision_score": -0.04925755875198707
    }
}